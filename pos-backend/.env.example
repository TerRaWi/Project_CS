# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่องที่รัน
# รันในเครื่องตัวเอง: PORT=3001, DB_HOST=localhost
# รันบน server ด้วย docker-compose: ค่าถูกตั้งใน docker-compose.yaml แล้ว (PORT=4000, DB_HOST=mysql-db)
PORT=3001
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=posdb
# จำนวน connection สูงสุดใน pool (ไม่ใส่ = 10)
# DB_CONNECTION_LIMIT=10
