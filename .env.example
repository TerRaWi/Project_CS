# คัดลอกไฟล์นี้เป็น .env.local แล้วแก้ค่าให้ตรงกับเครื่องที่รัน
# แก้ไฟล์นี้แล้วต้องรีสตาร์ท Next.js (npm run dev) ใหม่

# หน้าเว็บเรียก API ที่ไหน ค่าเริ่มต้น /api จะผ่าน rewrites ใน next.config.mjs ไปที่ BACKEND_URL
NEXT_PUBLIC_API_URL=/api

# ที่อยู่ของ backend (Express) ที่ Next.js จะส่งต่อ /api และ /uploads ไปให้
# เครื่องตัวเอง: http://localhost:3001   server: http://203.159.93.245:3001
BACKEND_URL=http://localhost:3001

# ที่อยู่ของหน้าเว็บที่มือถือลูกค้าเปิดได้ ใช้สร้าง QR Code สั่งอาหาร
# ใส่ IP ของเครื่องนี้ในวง Wi-Fi ของร้าน (ดูได้จากคำสั่ง ipconfig) ห้ามใช้ localhost
NEXT_PUBLIC_APP_URL=http://192.168.1.10:3000
